* text=auto

*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf

# Vendor font binaries are hash-bound and must never receive text conversion.
web/src/assets/fonts/*.ttf -text
web/public/THIRD-PARTY-NOTICES.txt text eol=lf
web/public/licenses/HarmonyOS-Sans.txt text eol=lf

# Hash-bound packaged E2E assets must keep the same bytes on Windows and POSIX.
internal/packagede2e/testdata/** text eol=lf
internal/desktop/testdata/standard-code-security/** text eol=lf
scripts/standard-code-packaged-e2e.ps1 text eol=lf

# Runtime verifies the generated baseline byte digest before using it.
internal/store/clean_install_baseline.sql text eol=lf
