{
  "name": "prayu-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:api": "npm run generate:api && git diff --exit-code -- src/api/schema.d.ts",
    "preview": "vite preview",
    "generate:api": "openapi-typescript ../docs/openapi.json -o src/api/schema.d.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "4.7.0",
    "@tanstack/react-query": "5.102.8",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.34.0",
    "monaco-editor": "0.56.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "js-yaml": "4.3.1"
    },
    "brace-expansion": "5.0.9",
    "dompurify": "3.4.13",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "undici": "7.29.0"
  }
}
